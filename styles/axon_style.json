{
  "_doc": "Axon (exploded + massing-step) style profile. Values in pt unless suffixed. See docs/AXON_STYLE.md.",
  "scale": {
    "paper_in": 1.0,
    "model_ft": 45.0,
    "pt_per_ft": 1.6
  },
  "projection": {
    "type": "isometric",
    "axis_angle_deg": 30,
    "foreshorten": false,
    "make2d_upscale_pct": 122.474
  },
  "artboard": {
    "name": "ARCH D",
    "width_in": 36,
    "height_in": 24,
    "margin_in": 1.0,
    "color_mode": "RGB",
    "raster_ppi": 300
  },
  "lines": {
    "silhouette": {
      "width": 2.5,
      "color": "#000000",
      "join": "round",
      "cap": "round"
    },
    "silhouette_slab": {
      "width": 2.0,
      "color": "#000000",
      "join": "round",
      "cap": "round"
    },
    "fold_edge": {
      "width": 1.0,
      "color": "#000000",
      "join": "round",
      "cap": "round"
    },
    "division": {
      "width": 0.5,
      "color": "#FFFFFF",
      "join": "miter",
      "cap": "butt"
    },
    "division_massing": {
      "width": 0.5,
      "color": "#000000",
      "join": "miter",
      "cap": "butt"
    },
    "context": {
      "width": 0.35,
      "color": "#A6A6A6",
      "join": "miter",
      "cap": "butt"
    },
    "hidden": {
      "width": 0.5,
      "color": "#808080",
      "dash": [
        3,
        2
      ],
      "cap": "butt"
    },
    "leader": {
      "width": 0.35,
      "color": "#B8B8B8",
      "cap": "butt"
    },
    "action": {
      "width": 0.75,
      "color": "#000000",
      "cap": "round"
    },
    "cut_line": {
      "width": 0.5,
      "color": "#000000",
      "dash": [
        2,
        2
      ],
      "cap": "butt"
    }
  },
  "faces": {
    "program": {
      "top_black_pct": 0,
      "left_black_pct": 10,
      "right_black_pct": 20,
      "method": "extra fill #000000 at N% opacity, Multiply"
    },
    "neutral": {
      "top": "#FFFFFF",
      "left": "#F5F5F5",
      "right": "#E6E6E6"
    }
  },
  "exploded": {
    "slab_thickness_ft": 3.75,
    "pitch_rule": "max(gap_factor * floor_height, min_top_visible * projected_top_depth)",
    "gap_factor": 1.5,
    "min_top_visible": 0.7,
    "max_plates": 7,
    "group_typical_floors": true,
    "side_faces": "program",
    "core": {
      "fill": "#D9D9D9",
      "label": "CORE"
    },
    "connector": {
      "fill": "#E9E4D3",
      "opacity": 0.6,
      "blend": "normal",
      "stroke": "#B5AE9C",
      "stroke_width": 0.5
    }
  },
  "massing": {
    "faces": "neutral",
    "program_band": {
      "opacity": 0.6,
      "blend": "multiply",
      "stroke": null
    },
    "facade_veil": {
      "fill": "#FFFFFF",
      "opacity": 0.3
    },
    "grid": {
      "cols": 2,
      "rows": 2,
      "gutter_in": 1.0,
      "anchor": "site_min_corner"
    }
  },
  "context": {
    "ground": {
      "fill": "#F5F5F5",
      "stroke": "context"
    },
    "block": {
      "fill": "#EBEBEB",
      "stroke": "context"
    },
    "road": {
      "fill": "#D9D9D9",
      "stroke": null
    },
    "landscape": {
      "fill": "#D7DEBC",
      "stroke": null
    },
    "tree": {
      "fill": "#C8E2BF",
      "stroke": "#7A9A6A",
      "stroke_width": 0.35
    },
    "building": {
      "fill": "#FFFFFF",
      "stroke": "context"
    },
    "street_arrow": {
      "fill": "#A6A6A6",
      "band_width": 12,
      "head_width": 24,
      "head_length": 18
    }
  },
  "text": {
    "_doc": "Measured from the Atlanta exploded axon (reference 1), assumed to be an 11x17 board (1 px = 0.612 pt). Sizes below are 11x17 pt; on ARCH D multiply by page_text_scale so the sheet reduced to 11x17 matches the reference exactly.",
    "font": "Arial",
    "page_text_scale": 2.118,
    "label_primary": {
      "size": 20,
      "weight": "Bold",
      "case": "upper",
      "tracking": 0,
      "color": "#FFFFFF",
      "opacity": 0.7,
      "page_scaled": false
    },
    "label_secondary": {
      "size": 16,
      "weight": "Bold",
      "case": "upper",
      "tracking": 0,
      "color": "#FFFFFF",
      "opacity": 0.7,
      "page_scaled": false
    },
    "label_min_size": 5,
    "label_fit_ratio": 0.6,
    "label_core": {
      "size": 7,
      "weight": "Bold",
      "case": "upper",
      "tracking": 0,
      "color": "#1A1A1A",
      "opacity": 1.0
    },
    "level": {
      "size": 7,
      "weight": "Regular",
      "case": "title",
      "tracking": 0,
      "color": "#333333",
      "opacity": 1.0
    },
    "annotation": {
      "size": 8,
      "weight": "Bold",
      "case": "upper",
      "tracking": 0,
      "color": "#000000",
      "opacity": 1.0,
      "leading": 8
    },
    "street": {
      "size": 5.5,
      "weight": "Regular",
      "case": "upper",
      "tracking": 0,
      "color": "#333333",
      "opacity": 1.0
    },
    "legend": {
      "size": 7,
      "weight": "Regular",
      "case": "upper",
      "tracking": 0,
      "color": "#333333",
      "opacity": 1.0
    },
    "step_title": {
      "size": 8,
      "weight": "Regular",
      "case": "upper",
      "tracking": 0,
      "color": "#000000",
      "opacity": 1.0
    },
    "label_anchor": "front_corner",
    "label_inset_pt": 8,
    "_doc_label": "Program labels: sizes are final ARCH D pt (page_scaled=false). Anchored at the top face's front corner: up-right text starts there (text-local lower-left), down-right text ends there (text-local lower-right); inset by label_inset_pt from both edges.",
    "_doc_font": "Unified diagram font: Arial (see styles/site_style.json typography). Was Myriad Pro."
  },
  "level_tag": {
    "marker_pt": 4,
    "marker_fill": "#FBBC10",
    "marker_stroke": "#C99600",
    "marker_stroke_pt": 0.25,
    "marker_text_gap_pt": 4,
    "column_offset_in": 1.5,
    "leader_direction": "iso_x",
    "leader_color": "#B8B8B8"
  },
  "ai_layers": [
    "OVERLAY",
    "_MANUAL",
    "ANNO_LEVEL",
    "LABEL",
    "LINE",
    "CONNECTOR",
    "PROGRAM",
    "FACADE",
    "CONTEXT",
    "SITE"
  ],
  "elements": {
    "_doc": "Legend elements, sampled from reference 1. *_pt values are 11x17 pt (x page_text_scale on ARCH D).",
    "core": {
      "fill": "#D9D9D9",
      "stroke": null,
      "label": "CORE"
    },
    "facade": {
      "fill": "#E9E4D3",
      "opacity": 0.6,
      "blend": "normal",
      "stroke": "#B5AE9C",
      "stroke_pt": 0.25
    },
    "transportation": {
      "fill": "#FDBE0E",
      "band_pt": 4.8,
      "stroke": null,
      "street_label": "street"
    },
    "flow": {
      "fill": "#F7C66F",
      "opacity": 0.85,
      "band_pt": 4.8,
      "stroke": "#D99A2B",
      "stroke_pt": 0.25
    },
    "annotation": {
      "text": "annotation",
      "arrow_pt": 1.0,
      "arrow_color": "#000000",
      "head_pt": 6,
      "head": "open"
    }
  }
}
