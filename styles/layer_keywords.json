{
  "version": 2,
  "comment": "Case-insensitive match on the layer's own name (last path segment); sub-layers never inherit the parent's role. Rules marked first run before program-name matching; the rest after it. First match wins. Roles: Program and NC.* = our new construction; BG.* = existing context. A site role (Tree/Water/Landscape/Hardscape) on a layer whose path contains an NC / NEW / PROJECT / PROPOSED segment becomes the NC.* variant.",
  "roles": [
    "Program",
    "NC.Core",
    "NC.Stair",
    "NC.Slab",
    "NC.Facade",
    "NC.Structure",
    "NC.Green",
    "NC.Hardscape",
    "NC.Tree",
    "NC.Water",
    "BG.Building",
    "BG.Road",
    "BG.Hardscape",
    "BG.Landscape",
    "BG.Tree",
    "BG.Water",
    "BG.Base",
    "BG.Line",
    "Ignore"
  ],
  "rules": [
    {
      "pattern": "^CORES?$|^CORE[-_ ]|[-_ ]CORE$",
      "role": "NC.Core",
      "first": true
    },
    {
      "pattern": "STAIR|ELEVATOR|ESCALATOR|^LIFT|TRANSPORT|SHAFT|^VERT",
      "role": "NC.Stair",
      "first": true
    },
    {
      "pattern": "STRUCT|COLUMN|BEAM|^COL$|BRACE",
      "role": "NC.Structure",
      "first": true
    },
    {
      "pattern": "GREEN ?ROOF|GREEN ?SPACE|TERRACE|PLANTER|ROOF ?GARDEN",
      "role": "NC.Green",
      "first": true
    },
    {
      "pattern": "^(GLASS.*|CW|CW[-_ ].*|MULLION.*|CURTAIN ?WALL.*|FACADE.*|FIN|FINS|PANEL.*)$",
      "role": "NC.Facade"
    },
    {
      "pattern": "SLAB",
      "role": "NC.Slab"
    },
    {
      "pattern": "TREE",
      "role": "BG.Tree"
    },
    {
      "pattern": "ROAD|STREET",
      "role": "BG.Road"
    },
    {
      "pattern": "WATER|POND|POOL",
      "role": "BG.Water"
    },
    {
      "pattern": "LANDSCAPE|GRASS|LAWN|PLANT|PARK",
      "role": "BG.Landscape"
    },
    {
      "pattern": "SITE|PLAZA|SIDEWALK|HARDSCAPE|PAVING",
      "role": "BG.Hardscape"
    },
    {
      "pattern": "CONTEXT",
      "role": "BG.Building"
    },
    {
      "pattern": "FRAME|BASE",
      "role": "BG.Base"
    },
    {
      "pattern": "PROPERTY|GRID|BOUNDARY",
      "role": "BG.Line"
    },
    {
      "pattern": "^DEFAULT$|RENDER|MATERIAL",
      "role": "Ignore"
    }
  ],
  "programFallback": "Program layer names are matched against program_legend.json aliases; a match gives role Program.",
  "unmatchedRole": "Ignore",
  "ncPathPattern": "(^|::)(NC|NEW|PROJECT|PROPOSED)([-_ ].*)?(::|$)",
  "legacyRoles": {
    "BG.Facade": "NC.Facade",
    "BG.Slab": "NC.Slab"
  }
}
