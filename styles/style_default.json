{
  "version": 1,
  "name": "Default (reference projects)",
  "background": {
    "block": {
      "fill": "#EBEBEB"
    },
    "road": {
      "fill": "#D9D9D9"
    },
    "hardscape": {
      "fill": "#F5F5F5"
    },
    "landscape": {
      "fill": "#D7DEBC"
    },
    "tree": {
      "fill": "#C8E2BF",
      "stroke": "#5A7F4F"
    },
    "groundBand": {
      "fill": "#E5E5E5"
    },
    "propertyLine": {
      "stroke": "#FF0000",
      "dash": [
        12,
        3,
        2,
        3
      ]
    },
    "useRhinoLayerColor": false
  },
  "roleModes": {
    "comment": "mode per role per drawing: grayscale | line | color",
    "BG.Building": {
      "plan": "grayscale",
      "section": "line",
      "axon": "grayscale"
    },
    "BG.Road": {
      "plan": "color",
      "section": "line",
      "axon": "color"
    },
    "BG.Hardscape": {
      "plan": "color",
      "section": "line",
      "axon": "color"
    },
    "BG.Landscape": {
      "plan": "color",
      "section": "line",
      "axon": "color"
    },
    "BG.Tree": {
      "plan": "color",
      "section": "line",
      "axon": "color"
    },
    "BG.Water": {
      "plan": "color",
      "section": "line",
      "axon": "color"
    },
    "BG.Facade": {
      "plan": "line",
      "section": "line",
      "axon": "color"
    },
    "BG.Slab": {
      "plan": "line",
      "section": "grayscale",
      "axon": "grayscale"
    },
    "BG.Base": {
      "plan": "line",
      "section": "grayscale",
      "axon": "grayscale"
    },
    "BG.Line": {
      "plan": "line",
      "section": "line",
      "axon": "line"
    }
  },
  "modes": {
    "grayscale": {
      "stroke": "#333333",
      "strokePt": 0.35
    },
    "line": {
      "fill": null,
      "stroke": "#000000",
      "strokePt": 0.35,
      "dash": null
    },
    "color": {
      "strokePt": 0.35
    }
  },
  "strokes": {
    "cutPt": 2.5,
    "outlinePt": 2.5,
    "roomPt": 0.5,
    "backgroundPt": 0.35,
    "beyond": {
      "strokePt": 0.5,
      "stroke": "#999999",
      "dash": [
        3,
        2
      ]
    }
  },
  "fonts": {
    "label": {
      "family": "Century Gothic",
      "sizePt": 7,
      "allCaps": true,
      "postScript": "CenturyGothic-Bold",
      "fallbackPostScript": "Arial-BoldMT",
      "weight": "bold"
    },
    "title": {
      "family": "Century Gothic",
      "sizePt": 14,
      "allCaps": true,
      "postScript": "CenturyGothic",
      "fallbackPostScript": "ArialMT",
      "weight": "normal"
    },
    "chart": {
      "family": "Helvetica",
      "fallback": "Arial",
      "sizePt": 7,
      "postScript": "Helvetica",
      "fallbackPostScript": "ArialMT"
    },
    "note": {
      "family": "Century Gothic",
      "postScript": "CenturyGothic",
      "fallbackPostScript": "ArialMT",
      "sizePt": 7,
      "allCaps": true,
      "weight": "normal"
    }
  },
  "facade": {
    "stackedAxonOpacity": 0.3,
    "explodedAxon": "hidden"
  },
  "section": {
    "slabPt": 3.0,
    "slabColor": "#000000",
    "barSlabGapPt": 2.0,
    "barCornerPt": 6.0,
    "barGapPt": 1.5,
    "programBackground": "#FFFFFF",
    "outlinePt": 0.75,
    "facadeCutPt": 0.5,
    "levelColumn": true,
    "levelLineStroke": "#999999",
    "levelLineStrokePt": 0.25,
    "heightDimension": true,
    "titlePrefix": "SECTION",
    "comment": "Cut parts of the section. What is seen behind the cut uses \"view\".",
    "groundSlabFactor": 2.0,
    "groundColor": "#000000",
    "contextCutStroke": "#000000",
    "contextCutStrokePt": 2.5,
    "contextCutFill": "#FFFFFF"
  },
  "page": {
    "marginPt": 36.0,
    "levelColumnPt": 78.0,
    "dimColumnPt": 46.0,
    "titleBandPt": 44.0,
    "labelColor": "#000000",
    "labelMinBarWidthPt": 14.0,
    "textReferenceScale": "1\" = 45'-0\"",
    "textComment": "All text sizes and annotation offsets are given at textReferenceScale and scale with the drawing scale."
  },
  "view": {
    "comment": "Projected (Make2D-like) view used behind section cuts and for elevations. Our building: masses = solid light-grey base; every slab/facade layer gets its own AI layer and global swatch (grey by layer order, glass white); all opaque, near hides far. Other buildings: white fill + dashed grey outline.",
    "massFill": "#E6E6E6",
    "massStroke": "#8C8C8C",
    "massStrokePt": 0.35,
    "edgeStroke": "#8C8C8C",
    "edgeStrokePt": 0.25,
    "glassPattern": "GLASS|GLAZ|^CW|CURTAIN|WINDOW|VISION",
    "glassFill": "#FFFFFF",
    "layerGrays": [
      "#C8C8C8",
      "#B0B0B0",
      "#9A9A9A",
      "#D6D6D6",
      "#848484"
    ],
    "layerFills": {},
    "contextFill": "#FFFFFF",
    "contextStroke": "#999999",
    "contextStrokePt": 0.5,
    "contextDash": [
      3,
      2
    ]
  },
  "elevation": {
    "titlePrefix": "ELEVATION",
    "levelMarkers": true,
    "levelLineStroke": "#808080",
    "levelLineStrokePt": 0.35,
    "levelLineDash": [
      6,
      3
    ],
    "markerSizePt": 6.0
  }
}
