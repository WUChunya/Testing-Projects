{
  "version": 1,
  "name": "Default (reference projects)",
  "background": {
    "block": {
      "fill": "#EBEBEB"
    },
    "road": {
      "fill": "#D9D9D9"
    },
    "hardscape": {
      "fill": "#F5F5F5"
    },
    "landscape": {
      "fill": "#D7DEBC"
    },
    "tree": {
      "fill": "#C8E2BF",
      "stroke": "#5A7F4F"
    },
    "groundBand": {
      "fill": "#E5E5E5"
    },
    "propertyLine": {
      "stroke": "#FF0000",
      "dash": [
        12,
        3,
        2,
        3
      ]
    },
    "useRhinoLayerColor": false
  },
  "roleModes": {
    "comment": "mode per role per drawing: grayscale | line | color",
    "BG.Building": {
      "plan": "grayscale",
      "section": "line",
      "axon": "grayscale"
    },
    "BG.Road": {
      "plan": "color",
      "section": "line",
      "axon": "color"
    },
    "BG.Hardscape": {
      "plan": "color",
      "section": "line",
      "axon": "color"
    },
    "BG.Landscape": {
      "plan": "color",
      "section": "line",
      "axon": "color"
    },
    "BG.Tree": {
      "plan": "color",
      "section": "line",
      "axon": "color"
    },
    "BG.Water": {
      "plan": "color",
      "section": "line",
      "axon": "color"
    },
    "BG.Facade": {
      "plan": "line",
      "section": "line",
      "axon": "color"
    },
    "BG.Slab": {
      "plan": "line",
      "section": "grayscale",
      "axon": "grayscale"
    },
    "BG.Base": {
      "plan": "line",
      "section": "grayscale",
      "axon": "grayscale"
    },
    "BG.Line": {
      "plan": "line",
      "section": "line",
      "axon": "line"
    }
  },
  "modes": {
    "grayscale": {
      "stroke": "#333333",
      "strokePt": 0.35
    },
    "line": {
      "fill": null,
      "stroke": "#000000",
      "strokePt": 0.35,
      "dash": null
    },
    "color": {
      "strokePt": 0.35
    }
  },
  "strokes": {
    "cutPt": 2.5,
    "outlinePt": 2.5,
    "roomPt": 0.5,
    "backgroundPt": 0.35,
    "beyond": {
      "strokePt": 0.5,
      "stroke": "#999999",
      "dash": [
        3,
        2
      ]
    }
  },
  "fonts": {
    "label": {
      "family": "Century Gothic",
      "sizePt": 7,
      "allCaps": true,
      "postScript": "CenturyGothic-Bold",
      "fallbackPostScript": "Arial-BoldMT",
      "weight": "bold"
    },
    "title": {
      "family": "Century Gothic",
      "sizePt": 14,
      "allCaps": true,
      "postScript": "CenturyGothic",
      "fallbackPostScript": "ArialMT",
      "weight": "normal"
    },
    "chart": {
      "family": "Helvetica",
      "fallback": "Arial",
      "sizePt": 7,
      "postScript": "Helvetica",
      "fallbackPostScript": "ArialMT"
    },
    "note": {
      "family": "Century Gothic",
      "postScript": "CenturyGothic",
      "fallbackPostScript": "ArialMT",
      "sizePt": 7,
      "allCaps": true,
      "weight": "normal"
    }
  },
  "facade": {
    "stackedAxonOpacity": 0.3,
    "explodedAxon": "hidden"
  },
  "section": {
    "slabPt": 3.0,
    "slabColor": "#000000",
    "barSlabGapPt": 2.0,
    "barCornerPt": 6.0,
    "barGapPt": 1.5,
    "outlinePt": 0.75,
    "facadeCutPt": 0.5,
    "facadeBeyond": "#DCDCDC",
    "facadeBeyondPt": 0.25,
    "levelColumn": true,
    "levelLineStroke": "#999999",
    "levelLineStrokePt": 0.25,
    "heightDimension": true,
    "titlePrefix": "SECTION",
    "comment": "Beyond (own and other buildings) = dashed grey outline with white fill, drawn far-to-near so nearer masses hide farther ones. Cut context = black outline, white fill. Ground line = slab weight x groundSlabFactor, centred on grade.",
    "groundSlabFactor": 2.0,
    "groundColor": "#000000",
    "beyondStroke": "#999999",
    "beyondStrokePt": 0.5,
    "beyondDash": [
      3,
      2
    ],
    "beyondFill": "#FFFFFF",
    "contextCutStroke": "#000000",
    "contextCutStrokePt": 2.5,
    "contextCutFill": "#FFFFFF"
  },
  "page": {
    "marginPt": 36.0,
    "levelColumnPt": 78.0,
    "dimColumnPt": 46.0,
    "titleBandPt": 44.0,
    "labelColor": "#000000",
    "labelMinBarWidthPt": 14.0,
    "textReferenceScale": "1\" = 45'-0\"",
    "textComment": "All text sizes and annotation offsets are given at textReferenceScale and scale with the drawing scale."
  }
}
